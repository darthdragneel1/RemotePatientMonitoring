DATABASE_URL="postgresql://USER@localhost:5432/telemetry_dev"
PORT=4000
JWT_SECRET="replace-with-a-long-random-string"
NODE_ENV="development"
# Frontend application URL for CORS and email links
FRONTEND_URL="http://localhost:5173"

# Gmail SMTP Credentials for sending emails (optional, defaults to logging to console)
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASSWORD="your-16-character-app-password"
INGEST_API_KEY_NAME="x-mioconnect-key"
INGEST_API_KEY_VALUE="replace-with-a-long-random-string"
